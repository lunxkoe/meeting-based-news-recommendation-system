# 이 파일을 .env로 복사한 뒤 값을 채운다. (.env는 git에 올리지 않는다)

# MySQL 접속 정보 (SQLAlchemy 비동기 URL)
DB_CONN=mysql+aiomysql://<user>:<password>@<host>:3306/meetings_db

# Celery 브로커·결과 저장소
REDIS_URL=redis://localhost:6379/0

# 세션 쿠키 서명 키. 예: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Google Gemini API 키
GEMINI_API_KEY=

# Google Custom Search JSON API 키와 검색 엔진 ID(cx)
CUSTOM_SEARCH_JSON_API_KEY=
CUSTOM_SEARCH_ENGINE_API_KEY=
